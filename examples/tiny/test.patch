@@ -0,0 +1,13 @@
+import unittest
+
+from tinycalc import divide
+
+
+class DivideZeroTests(unittest.TestCase):
+    def test_zero_raises(self) -> None:
+        with self.assertRaisesRegex(ValueError, "divisor must not be zero"):
+            divide(10, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()

